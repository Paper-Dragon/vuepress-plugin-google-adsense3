{
  "name": "vuepress-plugin-google-adsense3",
  "version": "1.0.6",
  "license": "MIT",
  "description": "VuePress 2 plugin - google-Adsense",
  "keywords": [
    "vuepress-plugin",
    "vuepress",
    "vuepress 2",
    "vuepress-next",
    "plugin",
    "google",
    "adsense"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Paper-Dragon/vuepress-plugin-google-adsense3.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**"
  ],
  "scripts": {
    "build": "pnpm clean && tsc -b tsconfig.build.json",
    "release": "pnpm publish",
    "clean": "rimraf dist && rimraf -g *.tsbuildinfo",
    "move": "node ./scripts/index.js"
  },
  "dependencies": {
    "@vuepress/client": "2.0.0-rc.26",
    "@vuepress/core": "2.0.0-rc.26",
    "@vuepress/utils": "2.0.0-rc.26"
  },
  "devDependencies": {
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3"
  }
}
